##################################################
### Inativar Paciente
##################################################

DELETE {{baseUrl}}/1

##################################################
### CPF Inválido
##################################################

POST {{baseUrl}}
Content-Type: application/json

{
  "nome": "João Silva",
  "dataNascimento": "1990-05-20",
  "cpf": "123",
  "email": "joao@email.com",
  "falecido": false
}

##################################################
### Email Inválido
##################################################

POST {{baseUrl}}
Content-Type: application/json

{
  "nome": "João Silva",
  "dataNascimento": "1990-05-20",
  "cpf": "52998224725",
  "email": "email-invalido",
  "falecido": false
}

##################################################
### Paciente Falecido Sem Data Óbito
##################################################

POST {{baseUrl}}
Content-Type: application/json

{
  "nome": "João Silva",
  "dataNascimento": "1990-05-20",
  "cpf": "52998224725",
  "email": "joao@email.com",
  "falecido": true
}